# SmartCPET-RehabGuard — Environment Variables
# Copy this file to .env.local (for Next.js) or set as system environment variables.
# NEVER commit .env.local or any file containing real values.

# ── Backend API ────────────────────────────────────────────────────────────────
# FastAPI backend URL (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Raspberry Pi Socket.IO Server ──────────────────────────────────────────────
# Pi hostname or IP address running the FastAPI + Socket.IO backend
# Use mDNS hostname on local network, or direct IP
NEXT_PUBLIC_PI_SERVER_URL=http://mypi.local:5000

# ── Appwrite (Patient Database) ────────────────────────────────────────────────
# Leave blank to disable Appwrite integration
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_PATIENTS_COLLECTION_ID=

# ── AI Report Generation (OpenRouter) ──────────────────────────────────────────
# Required for the /report page AI-generated clinical summaries
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Appwrite Server-Side Setup (only for setup-appwrite.js) ────────────────────
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_HOST=cloud.appwrite.io
