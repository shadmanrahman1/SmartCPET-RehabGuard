# BioGait — Environment Variables
# Copy this file to .env or set as system environment variables.

# ── Camera Source ──────────────────────────────────────────────────────────────
# Use 0 for laptop webcam (default)
# For IP camera, set the full URL:
#   BIOGAIT_CAMERA_SOURCE=http://192.168.0.105:8080/video
BIOGAIT_CAMERA_SOURCE=0
